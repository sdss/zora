    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^23.2.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^2.2.12"
