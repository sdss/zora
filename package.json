    "@mdi/font": "^7.4.47",
    "aladin-lite": "^3.8.1",
    "axios": "^1.16.0",
    "core-js": "^3.49.0",
    "json-bigint": "^1.0.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "roboto-fontface": "^0.10.0",
    "splitpanes": "^3.2.0",
    "vue": "^3.5.0",
    "vue-papa-parse": "^3.1.0",
    "vue-router": "^4.6.4",
    "vue-tippy": "^6.7.1",
    "vuetify": "^3.12.5",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@pinia/testing": "^0.1.7",
    "@playwright/test": "^1.59.1",
